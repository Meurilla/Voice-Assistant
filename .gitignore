# Python caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Local secrets and environment files
.env
.env.*
!.env.example
*.key
*.pem

# Local config overrides
config/*.local.toml
config/local*.toml
config/secrets*.toml

# Runtime logs
logs/*
!logs/.gitkeep

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

